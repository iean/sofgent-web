NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=2026-03-29
NEXT_PUBLIC_SITE_ORIGIN=https://sofgent.com
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/sofgent

# Optional for future on-demand revalidation hooks
# SANITY_REVALIDATE_SECRET=

# Transactional email (contact form)
EMAIL_USER=
EMAIL_PASS=
CONTACT_TO_EMAIL=support@sofgent.com

# WhatsApp notification fan-out (optional)
WHATSAPP_NUMBER=
WHATSAPP_API_URL=

# Contact API rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional image generation workflow
# OpenAI is the best fit when you want PNG assets that drop directly into public/images.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1.5

# Freepik is also supported for async text-to-image generation.
FREEPIK_API_KEY=
FREEPIK_IMAGE_MODEL=seedream-v5-lite

# Optional default provider for the image generator CLI: openai or freepik
WEBSITE_IMAGE_PROVIDER=openai
