# ─────────────────────────────────────────────────────────────
# SofGent — runtime environment variables
# Copy to `.env.local` and fill in real values. Never commit secrets.
# ─────────────────────────────────────────────────────────────

# ── Sanity CMS ──────────────────────────────────────────────
# Public (safe to expose to the browser)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-03-29
# Server-only tokens (keep secret)
SANITY_API_READ_TOKEN=
# Required only for `npm run sanity:sync-content` (pushes content to Sanity)
SANITY_API_WRITE_TOKEN=

# ── Contact form email (nodemailer) ─────────────────────────
# SMTP credentials used by app/api/contact/route.ts
EMAIL_USER=
EMAIL_PASS=

# ── WhatsApp (optional contact channel) ─────────────────────
WHATSAPP_API_URL=
WHATSAPP_NUMBER=
